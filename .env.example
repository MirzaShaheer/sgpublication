# SG Publication - environment
#
# The site runs WITHOUT any of these set. Leads are logged to the console in
# development and the API route returns success so forms still work locally.

# Postgres connection string. Railway provides this automatically when you add
# a Postgres plugin to the project. Leave unset for local development.
DATABASE_URL="postgresql://user:password@localhost:5432/sg_publication?schema=public"

# Canonical site origin, used for absolute URLs in metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="https://sgpublication.com"

# Google Tag Manager container id, e.g. GTM-XXXXXXX.
# Leave unset and no tag manager script is injected.
NEXT_PUBLIC_GTM_ID=""
