# SG Publication - environment
#
# The site runs WITHOUT any of these set. Leads are logged to the console in
# development and the API route returns success so forms still work locally.

# Postgres connection string. Leave unset for local development: the site runs
# without it and logs each lead instead of storing it.
#
# ON VERCEL, use the POOLED connection string, the host with "-pooler" in it,
# and add the two query parameters. Vercel runs each request in its own
# short lived instance, so without a pooler a busy minute opens more
# connections than the database allows; and Prisma needs telling it is talking
# to one, or it prepares statements the pooler cannot keep.
#   DATABASE_URL="postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1"
#
# DATABASE_URL_UNPOOLED is the same database WITHOUT "-pooler", and is used only
# by prisma migrate. Migrations issue DDL and take advisory locks, neither of
# which survives a transaction mode pooler, so they have to bypass it. Leave it
# unset against a plain Postgres and Prisma falls back to DATABASE_URL.
# Both want a connect_timeout, and on Neon's free tier the direct one needs a
# generous one: Neon suspends the compute after a few minutes idle and the
# first connection waits for it to wake. Without it, prisma migrate deploy
# fails with P1001 "can't reach database server", which looks like a wrong
# host and is not.
DATABASE_URL="postgresql://user:password@localhost:5432/sg_publication?schema=public"
DATABASE_URL_UNPOOLED=""

# Canonical site origin, used for absolute URLs in metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="https://sgpublication.com"

# Google Tag Manager container id, e.g. GTM-XXXXXXX.
# Leave unset and no tag manager script is injected.
NEXT_PUBLIC_GTM_ID=""

# ---------------------------------------------------------------------------
# The dashboard at /admin
#
# BOTH of these must be set or /admin serves a 503 and there is no way in.
# That is deliberate: everything else here degrades to still working, but a
# dashboard that opened for anyone when misconfigured would expose every
# enquiry the site has ever taken.
#
# ADMIN_PASSWORD is the one you type. Make it long and random, not memorable.
# ADMIN_SESSION_SECRET signs the session cookie and is never typed anywhere.
# Generate each with: node -e "console.log(crypto.randomUUID())"
# Changing the secret signs everyone out, which is how you revoke a session.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# The notification email
#
# One email per enquiry, to you. Nothing is ever sent to the author: the on
# page confirmation is what tells them it worked, and answering an enquiry is
# a thing a person does by hand.
#
# With no RESEND_API_KEY the site still stores every lead and simply skips the
# send with a logged warning.
#
# RESEND_API_KEY from resend.com, starting re_.
# MAIL_FROM must be an address on a domain verified in Resend, or Resend
# refuses the send. Add SPF and DKIM records for sgpublication.com in Resend's
# domain settings first; without them the mail is delivered to spam. Your MX
# records are untouched, so the contact@ mailbox keeps working as it does now.
# LEAD_NOTIFY_TO is where new enquiries are sent. Defaults to MAIL_FROM.
RESEND_API_KEY=""
MAIL_FROM="SG Publication <contact@sgpublication.com>"
LEAD_NOTIFY_TO="contact@sgpublication.com"
